{
  "category": "surface-theme",
  "version": "1.0",
  "lastUpdated": "2026-06-22",
  "mirrorSpec": "components/ai/tokens/surface-theme.md",
  "contract": "components/ai/tokens/ai-tokens.ts",
  "description": "CSS-scoped surface themes via data-theme attribute. Redefines --ai-* vars per variant; bridges to DS and shadcn.",
  "attribute": "data-theme",
  "defaultTheme": "ai-default",
  "themes": [
    {
      "id": "ai-default",
      "label": "AI_RAMP Default",
      "description": "Light brand surface",
      "definition": "components/ai/tokens/themes/ai-default.ts"
    },
    {
      "id": "ai-bold",
      "label": "AI_RAMP Bold",
      "description": "Dark brand surface",
      "definition": "components/ai/tokens/themes/ai-bold.ts"
    },
    {
      "id": "ai-companion",
      "label": "AI_RAMP Companion",
      "description": "Warm tan companion surface",
      "definition": "components/ai/tokens/themes/ai-companion.ts"
    },
    {
      "id": "ai-aqua",
      "label": "AI_RAMP Aqua",
      "description": "Teal-influenced page gradients",
      "definition": "components/ai/tokens/themes/ai-aqua.ts"
    }
  ],
  "cssLoadOrder": [
    "components/ai/tokens/css/ai-surface.css",
    "components/ai/tokens/css/ai-component-tokens.css",
    "components/ai/tokens/css/ds-bridge.css",
    "components/ai/tokens/css/shadcn-bridge.css"
  ],
  "hardRules": [
    "Components read var(--ai-*) — never hardcode hex",
    "Theme files override Tier 1 palette or explicit --ai-* vars only",
    "Load ai-surface.css before bridge files",
    "DS hosts require zs-master-style on an ancestor"
  ],
  "react": {
    "provider": "components/ai/tokens/react/SurfaceThemeProvider.tsx",
    "import": "import { SurfaceThemeProvider } from './react'"
  },
  "maps": {
    "componentTokens": "components/ai/tokens/maps/component-tokens.json",
    "dsBridge": "components/ai/tokens/maps/ds-bridge.json",
    "shadcnBridge": "components/ai/tokens/maps/shadcn-bridge.json",
    "resolveVars": "components/ai/tokens/maps/ai-css-vars.ts"
  }
}
