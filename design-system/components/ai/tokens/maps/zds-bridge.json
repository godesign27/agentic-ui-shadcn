{
  "description": "Maps ZDS --zs-* CSS variables to --ai-* inside [data-theme^=\"ai-\"] scope",
  "source": "components/ai/tokens/css/zds-bridge.css",
  "scope": "[data-theme^=\"ai-\"]",
  "requires": ["zs-master-style on ancestor for ZDS component styles"],
  "mappings": [
    { "zds": "--zs-text-color", "ai": "--ai-zds-text" },
    { "zds": "--zs-helper-text-color", "ai": "--ai-zds-text-helper" },
    { "zds": "--zs-headline-text-color", "ai": "--ai-text-primary" },
    { "zds": "--zs-background", "ai": "--ai-surface-default" },
    { "zds": "--zs-surface-color-1", "ai": "--ai-surface-subtle" },
    { "zds": "--zs-surface-color-2", "ai": "--ai-surface-emphasis" },
    { "zds": "--zs-border-color", "ai": "--ai-border-default" },
    { "zds": "--zs-border-hover-color", "ai": "--ai-border-strong" },
    { "zds": "--zs-border-primary-color", "ai": "--ai-border-focus" },
    { "zds": "--zs-focus-outline-color", "ai": "--ai-border-focus" },
    { "zds": "--zs-interactive-primary-color", "ai": "--ai-action-primary" },
    { "zds": "--zs-interactive-primary-hover-color", "ai": "--ai-action-primary-hover" },
    { "zds": "--zs-interactive-primary-active-color", "ai": "--ai-action-primary-active" },
    { "zds": "--zs-button-background-color", "ai": "--ai-action-primary" },
    { "zds": "--zs-button-text-color", "ai": "--ai-text-on-action" },
    { "zds": "--zs-field-text-color", "ai": "--ai-zds-text" },
    { "zds": "--zs-field-border-color", "ai": "--ai-border-default" },
    { "zds": "--zs-field-background-color", "ai": "--ai-surface-default" },
    { "zds": "--zs-field-label-color", "ai": "--ai-text-primary" },
    { "zds": "--zs-tabs-active-bar-color", "ai": "--ai-action-primary" },
    { "zds": "--zs-warning-color", "ai": "--ai-signal" },
    { "zds": "--zs-warning-background-color", "ai": "--ai-signal-subtle" }
  ]
}
